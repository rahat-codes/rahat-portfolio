# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://rahat-portfolio.vercel.app

# Contact Form (optional - enable when you connect an email service)
# CONTACT_API_SECRET=your-secret-here
# RESEND_API_KEY=your-resend-key-here

# Admin / Auth (only needed if you add an admin dashboard later)
# NEXTAUTH_SECRET=your-nextauth-secret
# NEXTAUTH_URL=https://rahat-portfolio.vercel.app
