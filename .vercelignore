# Files and directories to ignore when deploying to Vercel

# Environment files (contain secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/

# Next.js build cache
.next/
out/
build/

# Version control
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation (not needed for runtime)
README.md
SECURITY.md
SECURITY_AUDIT.md

# Config files are needed for Vercel Next.js build
# tsconfig.json, tailwind.config.js, postcss.config.js are intentionally NOT ignored

# Package lock files ensure deterministic installs
# package-lock.json, pnpm-lock.yaml are intentionally NOT ignored
