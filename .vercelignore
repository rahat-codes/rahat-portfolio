# Files and directories to ignore when deploying to Vercel

# Environment files (contain secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/

# Next.js build cache
.next/
out/
build/

# Version control
.git/
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Documentation (not needed for runtime)
README.md
SECURITY.md
SECURITY_AUDIT.md

# Config files for local development (Vercel uses its own)
tsconfig.json
tailwind.config.js
postcss.config.js

# Package lock files (Vercel regenerates)
package-lock.json
pnpm-lock.yaml
